DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-random-64-char-string
ENVIRONMENT=development
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Email — Brevo (free 300/day)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Webhook Delivery

# Email — Resend (optional, requires verified domain for production)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Webhook Delivery <onboarding@resend.dev>
