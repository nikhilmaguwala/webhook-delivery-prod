# Neon PostgreSQL (required)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Upstash Redis (required for rate limiting & caching)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# API Worker secrets (set via wrangler secret put)
# JWT_SECRET=generate-a-64-char-random-string
# WEBHOOK_SIGNING_SECRET=generate-a-64-char-random-string
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Webhook Delivery <onboarding@resend.dev>
# Free alternative (no domain DNS): sign up at brevo.com, verify your Gmail sender, then:
# BREVO_API_KEY=xkeysib-xxxxxxxx
# BREVO_SENDER_EMAIL=you@gmail.com

# Dashboard (Vercel environment variables)
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare (for CI/CD deployment)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Vercel (for CI/CD deployment)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
